usage() {
    echo "Usage: <SCANNER> [--propupd <target>|--all] [--help]"
    echo ""
    echo "  --propupd <target>  Bless after HUMAN review (never automatic)."
    echo "  --help              Show this help"
    echo ""
    echo "Targets:"
    echo "  /etc/...            Configuration file (must be in CONFIG_FILES)"
    echo "  /usr/local/bin/...  Local binary (must be in LOCAL_FILES; absent file = removal-ack)"
    echo "  .../.ssh/...        SSH authorized_keys file"
    echo "  systemd             Update systemd unit files + enabled services"
    echo "  sudoers|pam|cron|sshdrop  Bless managed drop-in trees"
    echo "  cmdline             Bless current kernel cmdline"
    echo "  audit               Bless current audit rule count"
    echo "  --all               Re-baseline everything"
}

_PROPUPD_BUF=""
propupd_baseline_append() {
    local hash="$1" key="$2"
    _PROPUPD_BUF+="${hash}  ${key}"$'\n'
}

propupd_flush() {
    if [[ -n "$_PROPUPD_BUF" ]]; then
        printf '%s' "$_PROPUPD_BUF" >> "$BASELINE_FILE"
        _PROPUPD_BUF=""
    fi
}

propupd_config() {
    local f="$1"
    local entry_key="__etc:${f}__"
    if [[ ! -f "$f" ]]; then
        propupd_baseline_append "ABSENT" "$entry_key"
        echo "  $f: absent, marked ABSENT in baseline"
        return
    fi
    local hash
    hash=$(sha256sum "$f" 2>/dev/null | cut -d' ' -f1) || hash="ABSENT"
    propupd_baseline_append "$hash" "$entry_key"
    echo "  $f: hash updated"
}

propupd_local() {
    local f="$1"
    if [[ ! -f "$f" ]]; then
        echo "  $f: absent, marked ABSENT in baseline (explicit removal-ack)"
        propupd_baseline_append "ABSENT" "$f"
        return
    fi
    local hash
    hash=$(sha256sum "$f" 2>/dev/null | cut -d' ' -f1) || hash="ABSENT"
    propupd_baseline_append "$hash" "$f"
    echo "  $f: hash updated"
}

# tree_hash: aggregate content hash of managed dirs (drop-ins, spool, units).
# Missing dirs contribute an ABSENT marker (a dir appearing later = reviewable change).
# Output: "<filecount> <hash>" or "ABSENT" when no root exists.
tree_hash() {
    local d stream="" count=0 any_root=false
    for d in "$@"; do
        if [[ ! -d "$d" ]]; then
            stream+="ABSENT $d"$'\n'
            continue
        fi
        any_root=true
        local f
        while IFS= read -r f; do
            [[ -z "$f" ]] && continue
            count=$((count + 1))
            if [[ -L "$f" ]]; then
                local tgt
                tgt=$(readlink "$f" 2>/dev/null || echo "?")
                stream+="LINK $f -> $tgt"$'\n'
                stream+="$(sha256sum "$f" 2>/dev/null)"$'\n'
            else
                stream+="$(sha256sum "$f" 2>/dev/null)"$'\n'
            fi
        done < <(find "$d" \( -type f -o -type l \) 2>/dev/null | LC_ALL=C sort)
    done
    if ! $any_root; then echo "ABSENT"; return; fi
    local h
    h=$(printf '%s' "$stream" | sha256sum | cut -d' ' -f1)
    echo "$count $h"
}

check_managed_trees() {
    echo ""
    echo "=== Phase 2f: Managed Drop-in Trees ==="
    # label|dir1|dir2... (multi-root aggregates; presence markers included)
    local spec entry_key dirs
    local specs=(
        "sudoers|/etc/sudoers.d"
        "pam|/etc/pam.d"
        "cron|/etc/cron.d|/var/spool/cron|/etc/cron.hourly"
        "sshdrop|/etc/ssh/sshd_config.d"
    )
    for spec in "${specs[@]}"; do
        local label="${spec%%|*}"
        local rest="${spec#*|}"
        entry_key="__tree:${label}__"
        local IFS='|'
        local -a roots
        read -ra roots <<< "$rest"
        unset IFS
        local current stored
        current=$(tree_hash "${roots[@]}")
        stored=$(baseline_get "$entry_key")
        if [[ "$current" == "ABSENT" && -z "$stored" ]]; then
            echo "OK: $label absent (no roots present)"
        elif [[ -z "$stored" ]]; then
            echo "NEW: $label tree ($current; review + propupd, never auto-absorbed)"
            log_issue "WARNING" "new managed tree (unblessed): $label"
            [[ $FINAL_STATE -lt 1 ]] && FINAL_STATE=1
        elif [[ "$current" != "$stored" ]]; then
            echo "CHANGED: $label tree differs from baseline (was: $stored)"
            echo "  now:  $current"
            log_issue "WARNING" "$label tree changed"
            [[ $FINAL_STATE -lt 1 ]] && FINAL_STATE=1
        else
            echo "OK: $label tree unchanged ($current)"
        fi
    done
}

check_pacnew() {
    echo ""
    echo "=== Phase 2e: Pacnew/Pacsave Watch ==="
    # AIDE excludes *.pacnew/*.pacsave by design + /etc dir is meta-only: this
    # check keeps visibility on them (hygiene + /etc completeness). Threat
    # assessment: pacnew files are INERT (nothing ever reads them), not an
    # attack vector — missing upstream hardening is the only (slow, indirect)
    # cost. Hence INFO-only by design: listed while present, <USER> impact on
    # state/notify. No baseline, no seen-tracking, no propupd (merge = resolution).
    # A scan with pending pacnew still exits CLEAR if nothing else fires.
    local found=false
    local p
    while IFS= read -r p; do
        [[ -z "$p" ]] && continue
        local p_safe
        p_safe=$(printf '%s' "$p" | tr -d '\000-\010\013\014\016-\037\177')
        echo "INFO-PACNEW: $p_safe (pacnew pending review; informational only, merge when convenient)"
        found=true
    done < <(find /etc \( -name '*.pacnew' -o -name '*.pacsave' \) -type f 2>/dev/null | LC_ALL=C sort)
    if ! $found; then
        echo "OK: no pacnew/pacsave files under /etc"
    fi
}

propupd_ssh() {
    local keyfile="$1"
    local entry_key="__ssh:${keyfile}__"
    local count_entry="__ssh:${keyfile}:count__"

    if [[ ! -f "$keyfile" ]]; then
        propupd_baseline_append "e3b0c44298fc1c149afbf4c8995fb92427ae41e4649b934ca495991b7852b855" "$entry_key"
        propupd_baseline_append "0" "$count_entry"
        echo "  $keyfile: absent, cleared from baseline"
        return
    fi

    local keys
    keys=$(grep -v '^\s*#\|^\s*$' "$keyfile" 2>/dev/null) || true

    if [[ -z "$keys" ]]; then
        local kcount
        kcount=$(grep -c -v '^\s*#\|^\s*$' "$keyfile" 2>/dev/null) || true
        propupd_baseline_append "e3b0c44298fc1c149afbf4c8995fb92427ae41e4649b934ca495991b7852b855" "$entry_key"
        propupd_baseline_append "${kcount:-0}" "$count_entry"
        echo "  $keyfile: no active keys, empty hash in baseline"
        return
    fi

    local keys_hash key_count
    keys_hash=$(printf '%s\n' "$keys" | sha256sum | cut -d' ' -f1)
    key_count=$(printf '%s\n' "$keys" | wc -l)

    propupd_baseline_append "$keys_hash" "$entry_key"
    propupd_baseline_append "$key_count" "$count_entry"
    echo "  $keyfile: $key_count keys, hash updated"
}

propupd_systemd() {
    local unit_hash
    unit_hash=$(tree_hash "/etc/systemd/system")
    propupd_baseline_append "$unit_hash" "__tree:systemd__"

    local enabled
    enabled=$(timeout 30 systemctl list-unit-files --state=enabled --type=service --no-legend 2>/dev/null | awk '{print $1}' | sort | tr '\n' ' ') || true
    local enabled_hash
    enabled_hash=$(echo "$enabled" | sha256sum | cut -d' ' -f1)
    propupd_baseline_append "$enabled_hash" "__systemd_enabled__"

    echo "  systemd: units + enabled services updated"
}

propupd_tree() {
    local label="$1"
    shift
    local current
    current=$(tree_hash "$@")
    propupd_baseline_append "$current" "__tree:${label}__"
    echo "  $label tree: updated ($current)"
}

propupd_cmdline() {
    local cur
    cur=$(tr '\0' ' ' < /proc/cmdline 2>/dev/null | tr -s ' ' | sed 's/ $//')
    propupd_baseline_append "$cur" "__cmdline__"
    echo "  cmdline: updated"
}

propupd_audit() {
    local dump n
    dump=$(auditctl -l 2>/dev/null)
    n=$(printf '%s\n' "$dump" | grep -c .)
    propupd_baseline_append "$n $(printf '%s\n' "$dump" | sha256sum | cut -d' ' -f1)" "__audit_rules__"
    echo "  audit ruleset: updated ($n rules)"
}

propupd_all() {
    local f
    for f in "${CONFIG_FILES[@]}"; do propupd_config "$f"; done
    for f in "${LOCAL_FILES[@]}"; do propupd_local "$f"; done
    for f in "${SSH_AUTH_KEYS[@]}"; do propupd_ssh "$f"; done
    propupd_systemd
    propupd_tree "sudoers" "/etc/sudoers.d"
    propupd_tree "pam" "/etc/pam.d"
    propupd_tree "cron" "/etc/cron.d" "/var/spool/cron" "/etc/cron.hourly"
    propupd_tree "sshdrop" "/etc/ssh/sshd_config.d"
    propupd_cmdline
    propupd_audit
}

propupd() {
    local target="$1"
    if [[ -z "$target" ]]; then
        echo "FATAL: --propupd requires a target" >&2
        echo "Usage: <SCANNER> --propupd <file>|systemd|--all" >&2
        exit 1
    fi
    if [[ $# -gt 1 ]]; then
        echo "WARNING: extra arguments ignored: ${*:2}" >&2
    fi

    if [[ "$target" == --* ]] && [[ "$target" != "--all" ]]; then
        echo "FATAL: invalid target: $target" >&2
        echo "Usage: <SCANNER> --propupd <file>|systemd|--all" >&2
        exit 1
    fi

    case "$target" in
        --all)
            propupd_all
            ;;
        systemd)
            propupd_systemd
            ;;
        sudoers)
            propupd_tree "sudoers" "/etc/sudoers.d"
            ;;
        pam)
            propupd_tree "pam" "/etc/pam.d"
            ;;
        cron)
            propupd_tree "cron" "/etc/cron.d" "/var/spool/cron" "/etc/cron.hourly"
            ;;
        sshdrop)
            propupd_tree "sshdrop" "/etc/ssh/sshd_config.d"
            ;;
        cmdline)
            propupd_cmdline
            ;;
        audit)
            propupd_audit
            ;;
        *)
            local found=false entry
            for entry in "${CONFIG_FILES[@]}"; do
                if [[ "$entry" == "$target" ]]; then
                    propupd_config "$target"
                    found=true
                    break
                fi
            done
            if ! $found; then
                for entry in "${LOCAL_FILES[@]}"; do
                    if [[ "$entry" == "$target" ]]; then
                        propupd_local "$target"
                        found=true
                        break
                    fi
                done
            fi
            if ! $found; then
                for entry in "${SSH_AUTH_KEYS[@]}"; do
                    if [[ "$entry" == "$target" ]]; then
                        propupd_ssh "$target"
                        found=true
                        break
                    fi
                done
            fi
            if ! $found; then
                echo "FATAL: '$target' is not a tracked file or service" >&2
                echo "Tracked targets: CONFIG_FILES, LOCAL_FILES, SSH_AUTH_KEYS, systemd, --all" >&2
                exit 1
            fi
            ;;
    esac

    propupd_flush
    update_baseline
    echo "OK: baseline updated"
}

# === ARGUMENT HANDLING ===
if [[ $# -gt 0 ]]; then
    case "$1" in
        --propupd)
            shift
            if [[ $# -eq 0 ]]; then
                echo "FATAL: --propupd requires a target" >&2
                echo "Usage: <SCANNER> --propupd <file>|systemd|--all" >&2
                exit 1
            fi
            setup_dirs
            lock_acquire
            propupd "$@"
            exit $?
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "FATAL: unknown option: $1" >&2
            usage
            exit 1
            ;;
    esac
fi

# === MAIN ===
setup_dirs
lock_acquire

exec 3>&1

if ! exec > "$LOG_FILE" 2>&1; then
    echo "FATAL: cannot redirect to $LOG_FILE" >&2
    exit 1
fi
chmod 644 "$LOG_FILE" 2>/dev/null || true

echo "=== <SCANNER>: $(date) ==="
echo "Host: $(uname -n)"
echo "Kernel: $(uname -r)"
echo ""

check_pacman_integrity
check_local_integrity
check_ssh_keys
check_ld_preload
